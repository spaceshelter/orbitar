{
  "name": "e2e-tests",
  "version": "1.0.0",
  "description": "E2E tests for the frontend app using Cypress",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test": "cypress run",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --write .",
    "test:e2e:up": "docker-compose -f docker-compose.test.yml up",
    "test:e2e:down": "docker-compose -f docker-compose.test.yml down",
    "test:e2e:wait": "wait-on http://localhost:4000 http://localhost:3000",
    "test:e2e": "npm run test:e2e:up && npm run test:e2e:wait && node scripts/create-test-users.js && cypress run && npm run test:e2e:down"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.24",
    "cypress": "^13.17.0",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-cypress": "^2.12.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "wait-on": "^8.0.3"
  }
}
