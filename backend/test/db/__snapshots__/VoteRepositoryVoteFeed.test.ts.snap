// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`VoteRepository vote feed mine direction queries all three branches by voter with deterministic order and per-branch limits 1`] = `"select /*+ MAX_EXECUTION_TIME(500) */ type, entityId, postId, voterId, targetUserId, vote, votedAt from ( (select straight_join 'post' type, pv.post_id entityId, pv.post_id postId, pv.voter_id voterId, pv.target_user_id targetUserId, pv.vote, pv.voted_at votedAt from post_votes pv force index (idx_post_votes_voter_voted_at) join posts p on (p.post_id = pv.post_id) join users fu on (fu.user_id = pv.target_user_id) where pv.voter_id = :user_id and pv.vote != 0 and (p.source like :filter or p.title like :filter or fu.username like :filter or fu.name like :filter) order by pv.voted_at desc, pv.post_id desc, pv.voter_id desc limit :branch_limit) union all (select straight_join 'comment' type, cv.comment_id entityId, c.post_id postId, cv.voter_id voterId, cv.target_user_id targetUserId, cv.vote, cv.voted_at votedAt from comment_votes cv force index (idx_comment_votes_voter_voted_at) join comments c on (c.comment_id = cv.comment_id) join users fu on (fu.user_id = cv.target_user_id) where cv.voter_id = :user_id and cv.vote != 0 and c.deleted = 0 and (c.source like :filter or fu.username like :filter or fu.name like :filter) order by cv.voted_at desc, cv.comment_id desc, cv.voter_id desc limit :branch_limit) union all (select straight_join 'user' type, uk.user_id entityId, null postId, uk.voter_id voterId, uk.user_id targetUserId, uk.vote, uk.voted_at votedAt from user_karma uk force index (idx_user_karma_voter_voted_at) join users fu on (fu.user_id = uk.user_id) where uk.voter_id = :user_id and uk.vote != 0 and (fu.username like :filter or fu.name like :filter) order by uk.voted_at desc, uk.user_id desc, uk.voter_id desc limit :branch_limit)) votes order by votedAt desc, type desc, entityId desc, voterId desc limit :limit_count"`;

exports[`VoteRepository vote feed received direction uses denormalized target ids and no joins without filter 1`] = `"select type, entityId, postId, voterId, targetUserId, vote, votedAt from ( (select straight_join 'post' type, pv.post_id entityId, pv.post_id postId, pv.voter_id voterId, pv.target_user_id targetUserId, pv.vote, pv.voted_at votedAt from post_votes pv force index (idx_post_votes_target_voted_at) where pv.target_user_id = :user_id and pv.vote != 0 order by pv.voted_at desc, pv.post_id desc, pv.voter_id desc limit :branch_limit) union all (select straight_join 'comment' type, cv.comment_id entityId, c.post_id postId, cv.voter_id voterId, cv.target_user_id targetUserId, cv.vote, cv.voted_at votedAt from comment_votes cv force index (idx_comment_votes_target_voted_at) join comments c on (c.comment_id = cv.comment_id) where cv.target_user_id = :user_id and cv.vote != 0 and c.deleted = 0 order by cv.voted_at desc, cv.comment_id desc, cv.voter_id desc limit :branch_limit) union all (select straight_join 'user' type, uk.user_id entityId, null postId, uk.voter_id voterId, uk.user_id targetUserId, uk.vote, uk.voted_at votedAt from user_karma uk force index (idx_user_karma_user_voted_at) where uk.user_id = :user_id and uk.vote != 0 order by uk.voted_at desc, uk.user_id desc, uk.voter_id desc limit :branch_limit)) votes order by votedAt desc, type desc, entityId desc, voterId desc limit :limit_count"`;
