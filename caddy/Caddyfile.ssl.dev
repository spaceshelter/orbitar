{$SERVER_DOMAIN} {
	tls /certs/orbitar.crt /certs/orbitar.key

	@cors {
		header Origin https://{$SERVER_DOMAIN}
	}
	header @cors {
		Access-Control-Allow-Origin "{header.Origin}"
		Vary Origin
	}

	header {
		?Access-Control-Allow-Origin https://{$SERVER_DOMAIN}
		Vary Origin
	}

	# idiod.video proxy
	handle_path /upload {
		rewrite * /api/upload.php
		reverse_proxy {$MEDIA_HOSTING_URL} {
			header_up Host {upstream_hostport}
			header_up +authorization "Client-ID {$MEDIA_HOSTING_CLIENT_ID}"
			header_up -origin
			header_up -referer
		}
	}

	handle {
		reverse_proxy http://host.docker.internal:5000
	}
}

{$API_DOMAIN} {
	tls /certs/orbitar.crt /certs/orbitar.key

	header X-Fingerprint "{$FINGERPRINT}"
	header Access-Control-Expose-Headers "X-Fingerprint"

	reverse_proxy http://host.docker.internal:5001
}
