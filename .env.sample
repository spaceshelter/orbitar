#
# copy to .env before usage
#

MYSQL_ROOT_PASSWORD=orbitar
SERVER_DOMAIN=orbitar.local
API_DOMAIN=api.orbitar.local
REDIS_PASSWORD=orbitar

# Valid values:
# development
# production
ENVIRONMENT=development

# Valid values:
# tls_off
# tls_on
# tls_internal

# tls_off is the default mode.
# The last variant makes Caddy generate its own certs
TLS_MODE=tls_off

# These values are default, and need to be set and overridden if file names are different
# TLS_CERT_FILE=orbitar.crt
# TLS_KEY_FILE=orbitar.key

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=

MEDIA_HOSTING_URL=
MEDIA_HOSTING_CLIENT_ID=
MEDIA_HOSTING_DIMS_AES_KEY=

SENDING_BLUE_API_KEY=
DEEPL_API_KEY=

BARMALINI_USER_ID=
BARMALINI_KEY=

OPENAI_API_KEY=

# build UUID (optional)
# FINGERPRINT=

PWD=.
