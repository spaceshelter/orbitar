{
  "name": "orbitar",
  "version": "3.0.0",
  "description": "Self-regulating community blog engine",
  "workspaces": [
    "backend/",
    "frontend/"
  ],
  "scripts": {
    "start": "./node_modules/.bin/concurrently \"cd backend && npm run start:dev\" \"cd frontend && npm run start\"",
    "prettier": "prettier --check ./backend/src/ ./frontend/src/",
    "prettier:fix": "prettier --write ./backend/src/ ./frontend/src/"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "concurrently": "^8.2.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3"
  }
}
